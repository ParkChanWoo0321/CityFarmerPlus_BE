DB_URL=jdbc:mysql://localhost:3306/cityfarmerplus?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=replace-with-local-mysql-password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=https://api.cityfarmerplus.local
JWT_ACCESS_TOKEN_EXPIRATION=1h
FILE_STORAGE_ROOT=./data/uploads
FILE_CLEANUP_FIXED_DELAY=60000
FILE_CLEANUP_INITIAL_DELAY=60000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
