# Local development example only. Never commit real credentials or production secrets.
PORT=8080

# createDatabaseIfNotExist is for a disposable local database only.
DB_URL=jdbc:mysql://localhost:3306/cityfarmerplus?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=replace-with-local-mysql-password
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Use an independently generated secret with at least 32 random bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=https://api.cityfarmerplus.local
JWT_ACCESS_TOKEN_EXPIRATION=1h

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# local: FILE_STORAGE_ROOT is used. s3: S3_* is used. gcs: GCS_BUCKET is required.
FILE_STORAGE_TYPE=local

# Leave blank to disable the internal center-admin provisioning endpoint.
ADMIN_PROVISIONING_KEY=CHANGE_ME_ADMIN_KEY
FILE_STORAGE_ROOT=./data/uploads
FILE_CLEANUP_FIXED_DELAY=60000
FILE_CLEANUP_INITIAL_DELAY=60000

# S3-compatible object storage example (required when FILE_STORAGE_TYPE=s3).
S3_ENDPOINT=https://replace-with-s3-compatible-endpoint
S3_REGION=replace-with-region
S3_BUCKET=replace-with-private-bucket-name
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_PATH_STYLE=true
S3_PREFIX=cityfarmerplus/dev

# Google Cloud Storage example (required when FILE_STORAGE_TYPE=gcs).
# Authentication uses Application Default Credentials; do not add a key here.
# GCS_PROJECT_ID is optional when ADC can resolve the project.
GCS_PROJECT_ID=replace-with-gcp-project-id
GCS_BUCKET=replace-with-private-gcs-bucket-name
GCS_PREFIX=cityfarmerplus/dev
